# Copy to .env and fill in only what you use. RedSI reads keys by env-var
# *name*; values are never written to run artifacts or reports.

# Model providers (used for LLM judges, LLM test generation, OpenAI targets)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Gemini's OpenAI endpoint, ...)
# REDSI_BASE_URL=http://localhost:11434/v1
